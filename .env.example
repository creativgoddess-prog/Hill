# ─────────────────────────────────────────────────────────────
# OPTION 1 — Google Gemini (FREE, recommended)
# Get your free key in 60 seconds:
#   1. Go to aistudio.google.com
#   2. Sign in with any Google account (Gmail, etc.)
#   3. Click "Get API Key" → "Create API key"
#   4. Paste it below
# Free limits: 1,500 requests/day — more than enough for daily use
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=paste_your_gemini_key_here

# ─────────────────────────────────────────────────────────────
# OPTION 2 — Anthropic Claude (optional, paid ~$1-5/month)
# Only set this if you want to use Claude instead of Gemini.
# Get key at: console.anthropic.com
# ─────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=paste_your_claude_key_here

# ─────────────────────────────────────────────────────────────
# TELEGRAM BOT TOKEN (required for iPhone/iPad access)
# Get it free from @BotFather on Telegram (takes 2 minutes)
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=paste_your_telegram_token_here
